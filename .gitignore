# Magento generated code and caches
/generated/*
!/generated/.htaccess
/var/cache/*
/var/page_cache/*
/var/view_preprocessed/*
/var/composer_home/*
/var/di/*
/var/generation/*
/var/log/*
/var/report/*
/var/session/*
/var/tmp/*

# Magento static assets and media cache
/pub/static/*
