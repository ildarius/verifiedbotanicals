<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Blog Editor role: let restricted blog editors use Page Builder on blog posts, and hide or block
         the parts of it their role cannot use. See Local\BlogApi\Plugin\* for details. -->
    <type name="Magento\PageBuilder\Model\Stage\Config">
        <plugin name="local_blogapi_blog_editor_page_builder_acl"
                type="Local\BlogApi\Plugin\BlogEditorPageBuilderAcl"/>
    </type>
    <type name="Magento\Catalog\Ui\Component\UrlInput\Product">
        <plugin name="local_blogapi_blog_editor_product_link_search"
                type="Local\BlogApi\Plugin\BlogEditorProductLinkSearch"/>
    </type>
    <type name="Magento\Cms\Block\Adminhtml\Wysiwyg\Images\Content">
        <plugin name="local_blogapi_media_hide_delete_buttons"
                type="Local\BlogApi\Plugin\MediaDeleteGuard"/>
    </type>
    <type name="Magento\Cms\Controller\Adminhtml\Wysiwyg\Images\DeleteFiles">
        <plugin name="local_blogapi_media_guard_delete_files"
                type="Local\BlogApi\Plugin\MediaDeleteGuard"/>
    </type>
    <type name="Magento\Cms\Controller\Adminhtml\Wysiwyg\Images\DeleteFolder">
        <plugin name="local_blogapi_media_guard_delete_folder"
                type="Local\BlogApi\Plugin\MediaDeleteGuard"/>
    </type>
</config>
