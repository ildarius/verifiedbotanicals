<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Let restricted blog editors open Page Builder on blog posts without the Widgets permission. -->
    <type name="Magento\PageBuilder\Model\Stage\Config">
        <plugin name="local_blogapi_blog_editor_page_builder_acl"
                type="Local\BlogApi\Plugin\BlogEditorPageBuilderAcl"/>
    </type>
</config>
