<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Magento_Backend::content_elements">
                        <resource id="Magento_Cms::media_gallery">
                            <resource id="Local_BlogApi::media_delete" title="Delete Media Files and Folders" sortOrder="10"/>
                        </resource>
                    </resource>
                    <resource id="Local_BlogApi::blog_api" title="Local Blog API" sortOrder="900">
                        <resource id="Local_BlogApi::post_upsert" title="Upsert Blog Posts" sortOrder="10"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
