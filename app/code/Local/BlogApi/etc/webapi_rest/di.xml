<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The anonymous blog post list service must not list "Shop profiles" posts either. -->
    <type name="Magefan\Blog\Model\ResourceModel\Post\Collection">
        <plugin name="local_blogapi_exclude_shop_profiles"
                type="Local\BlogApi\Plugin\ExcludeShopProfilesFromListings"/>
    </type>
</config>
