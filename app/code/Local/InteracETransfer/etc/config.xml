<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <interac_etransfer>
                <active>1</active>
                <model>Local\InteracETransfer\Model\Method\InteracETransfer</model>
                <order_status>awaiting_etransfer</order_status>
                <payment_action>order</payment_action>
                <title>Interac e-Transfer</title>
                <allowspecific>0</allowspecific>
                <sort_order>15</sort_order>
                <group>offline</group>
                <short_notice>Orders paid by Interac e-Transfer are submitted immediately but remain pending until payment is received and verified. Please complete the transfer promptly after placing your order.</short_notice>
                <recipient_name>Verified Botanicals</recipient_name>
                <recipient_email>vbpay@tutamail.com</recipient_email>
                <payment_window_hours>72</payment_window_hours>
            </interac_etransfer>
        </payment>
        <sales_email>
            <general>
                <async_sending>0</async_sending>
            </general>
            <order>
                <enabled>1</enabled>
            </order>
        </sales_email>
        <trans_email>
            <ident_general>
                <name>Verified Botanicals</name>
                <email>robert@verifiedbotanicals.com</email>
            </ident_general>
            <ident_sales>
                <name>Verified Botanicals</name>
                <email>robert@verifiedbotanicals.com</email>
            </ident_sales>
            <ident_support>
                <name>Verified Botanicals</name>
                <email>robert@verifiedbotanicals.com</email>
            </ident_support>
            <ident_custom1>
                <name>Verified Botanicals</name>
                <email>robert@verifiedbotanicals.com</email>
            </ident_custom1>
            <ident_custom2>
                <name>Verified Botanicals</name>
                <email>robert@verifiedbotanicals.com</email>
            </ident_custom2>
        </trans_email>
    </default>
</config>
