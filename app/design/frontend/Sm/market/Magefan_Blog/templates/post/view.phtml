<?php
/**
 * Blog post view template
 *
 * @var $block \Magefan\Blog\Block\Post\View
 */
?>
<?php
$_post = $block->getPost();
$_postName = trim((string)$_post->getTitle());

$normalizeHeading = static function (string $value): string {
    $value = html_entity_decode(strip_tags($value), ENT_QUOTES | ENT_HTML5, 'UTF-8');
    $value = preg_replace('/\s*\|\s*Verified Botanicals\s*$/i', '', $value) ?? $value;
    $value = preg_replace('/\s+/', ' ', trim($value)) ?? trim($value);

    return function_exists('mb_strtolower') ? mb_strtolower($value, 'UTF-8') : strtolower($value);
};

$content = (string)$block->getContent();
$normalizedTitles = array_filter([
    $normalizeHeading($_postName),
    $normalizeHeading((string)$_post->getMetaTitle()),
]);

$content = preg_replace_callback(
    '/^\s*<h1\b[^>]*>(.*?)<\/h1>\s*/is',
    static function (array $matches) use ($normalizeHeading, $normalizedTitles): string {
        $heading = $normalizeHeading($matches[1]);
        foreach ($normalizedTitles as $title) {
            if ($heading === $title) {
                return '';
            }
        }

        return $matches[0];
    },
    $content,
    1
);

$content = preg_replace_callback(
    '/<p\b([^>]*)>(.*?)<\/p>/is',
    static function (array $matches): string {
        $plainText = trim(html_entity_decode(strip_tags($matches[2]), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
        if (stripos($plainText, 'Not intended for human consumption') !== 0) {
            return $matches[0];
        }

        $attributes = $matches[1];
        if (preg_match('/\bclass\s*=\s*"([^"]*)"/i', $attributes, $classMatch)) {
            $classes = trim($classMatch[1] . ' article-note');
            $attributes = preg_replace(
                '/\bclass\s*=\s*"([^"]*)"/i',
                'class="' . htmlspecialchars($classes, ENT_QUOTES, 'UTF-8') . '"',
                $attributes,
                1
            ) ?? $attributes;
        } else {
            $attributes .= ' class="article-note"';
        }

        return '<p' . $attributes . '>' . $matches[2] . '</p>';
    },
    $content
);
?>
<article class="post-view post-article">
    <div class="post-holder post-holder-<?= (int)$_post->getId() ?>">
        <header class="post-hero">
            <h1 class="post-title"><?= $block->escapeHtml($_postName) ?></h1>
            <?= /* @noEscape */ $block->getInfoHtml() ?>
        </header>

        <?php if ($featuredImage = $_post->getFeaturedImage()): ?>
            <?php
            $featuredImgAlt = (string)$_post->getData('featured_img_alt');
            if ($featuredImgAlt === '') {
                $featuredImgAlt = $_postName;
            }
            ?>
            <figure class="post-featured-image">
                <img src="<?= $block->escapeUrl($featuredImage) ?>" alt="<?= $block->escapeHtmlAttr($featuredImgAlt) ?>" />
            </figure>
        <?php endif; ?>

        <div class="post-content">
            <div class="post-body post-text-hld">
                <?= /* @noEscape */ $content ?>
            </div>
        </div>

        <div class="post-bottom">
            <?= $block->getChildHtml('blog.post.bottom') ?>
        </div>
    </div>
</article>
