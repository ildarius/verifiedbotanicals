$headContentOutput = $headContent;

if (strpos((string)$bodyAttributes, 'cms-index-index') !== false) {
    $homepageTitle = (string)__('Buy kratom in Montreal and Canada wide shipping by Verified Botanicals');
    $headContentOutput = preg_replace_callback(
        '#<title>(.*?)</title>#s',
        static function (array $matches) use ($homepageTitle): string {
            return '<title>' . htmlspecialchars($homepageTitle, ENT_QUOTES, 'UTF-8') . '</title>';
        },
        $headContentOutput,
        1
    );
} elseif (strpos((string)$bodyAttributes, 'catalog-product-view') !== false) {
    $suffix = ' ' . (string)__('Montreal and Canada Wide Shipping');
    $headContentOutput = preg_replace_callback(
        '#<title>(.*?)</title>#s',
        static function (array $matches) use ($suffix): string {
            $title = html_entity_decode($matches[1], ENT_QUOTES, 'UTF-8');

            if (!str_ends_with($title, $suffix)) {
                $title .= $suffix;
            }

            return '<title>' . htmlspecialchars($title, ENT_QUOTES, 'UTF-8') . '</title>';
        },
        $headContentOutput,
        1
    );
}
?>
<!doctype html>
<html <?= /* @noEscape */ $htmlAttributes ?>>
    <head <?= /* @noEscape */ $headAttributes ?>>
        <?= /* @noEscape */ $requireJs ?>
        <?= /* @noEscape */ $headContentOutput ?>
        <?= /* @noEscape */ $headAdditional ?>
    </head>
    <body data-container="body"
          data-mage-init='{"loaderAjax": {}, "loader": { "icon": "<?= /* @noEscape */ $loaderIcon ?>"}}'
        <?= /* @noEscape */ $bodyAttributes ?>>
        <?= /* @noEscape */ $layoutContent ?>
    </body>
</html>
