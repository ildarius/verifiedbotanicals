<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <move element="page.messages" destination="page.wrapper" before="-"/>
        <referenceBlock name="breadcrumbs" remove="true"/>

        <referenceBlock name="theme_header">
            <block class="Magento\Cms\Block\Block" name="slider-header" after="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">slider-header</argument>
                </arguments>
            </block>
        </referenceBlock>

        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="home.hero"
                   template="Sm_Market::home/hero.phtml"
                   before="-">
                <block class="Sm\MegaMenu\Block\MegaMenu\View"
                       name="home.hero.vertical.menu"
                       as="vertical_menu"
                       template="Sm_MegaMenu::vertical.phtml">
                    <arguments>
                        <argument name="theme" xsi:type="string">2</argument>
                        <argument name="group_id" xsi:type="string">5</argument>
                        <argument name="title" xsi:type="string">Shop by Categories</argument>
                        <argument name="limit" xsi:type="string">7</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>

    </body>
</page>
